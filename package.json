{
  "name": "education-service-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Service website for academic document support, with the BTEB result search portal hosted alongside it",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
